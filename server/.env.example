# ============================================
# PAYROLL MODELING SANDBOX — BACKEND CONFIG
# ============================================
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# Server Configuration
PORT=5000
NODE_ENV=development

# ============================================
# DATABASE — MongoDB Atlas
# ============================================
# Get your connection string from:
# https://cloud.mongodb.com/v2/[project-id]#clusters
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/payroll-sandbox?retryWrites=true&w=majority

# ============================================
# JWT — Token Generation & Verification
# ============================================
# JWT_SECRET should be at least 32 random characters
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_key_minimum_32_chars_change_this_in_production

# JWT expiration time (use Node.js time format)
# Examples: 7d (7 days), 24h (24 hours), 3600 (3600 seconds)
JWT_EXPIRES_IN=7d

# ============================================
# FILE STORAGE — Local Directories
# ============================================
# Relative paths from server root
UPLOAD_DIR=./uploads/temp
EXPORT_DIR=./exports/reports

# Maximum file size in MB
MAX_FILE_SIZE_MB=10

# ============================================
# PYTHON SOLVER — Child Process Configuration
# ============================================
# Path to Python executable
PYTHON_PATH=python3

# Path to main solver script
SOLVER_SCRIPT_PATH=./solver/solver.py

# Timeout for solver execution (milliseconds)
SOLVER_TIMEOUT_MS=30000
