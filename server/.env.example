# Backend Environment Variables
# Copy this to .env and fill in your values

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/motek-payroll

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_EXPIRE=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rollfi Configuration (mocked for now)
ROLLFI_MOCK=true
ROLLFI_API_URL=https://api.rollfi.com/v1
ROLLFI_API_KEY=your-rollfi-api-key-here

# Python Solver
PYTHON_EXECUTABLE=python3
