# Server Environment Variables
# Copy this file to .env and fill in your values
# Never commit the .env file

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/motek_payroll

# JWT secret — use at least 32 random characters
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT expiry
JWT_EXPIRES_IN=8h

# Server port
PORT=5000

# CORS origin — frontend URL
CORS_ORIGIN=http://localhost:3000

# Set to true to use mock Rollfi data (no real API needed)
ROLLFI_MOCK=true

# Rollfi API base URL (used when ROLLFI_MOCK=false)
ROLLFI_API_URL=https://api.rollfi.com
ROLLFI_API_KEY=your_rollfi_api_key_here

# Node environment
NODE_ENV=development
