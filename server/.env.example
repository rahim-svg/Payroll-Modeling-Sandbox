# Server Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file

# Node environment
NODE_ENV=development

# Server port
PORT=5000

# MongoDB connection string
# Local: mongodb://localhost:27017/motek_payroll
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/motek_payroll
MONGODB_URI=mongodb://localhost:27017/motek_payroll

# JWT Secret — must be at least 32 random characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters

# JWT expiry
JWT_EXPIRES_IN=8h

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# Rollfi API — set ROLLFI_MOCK=false when real API is ready
ROLLFI_MOCK=true
ROLLFI_API_URL=https://api.rollfi.com
ROLLFI_API_KEY=your_rollfi_api_key_here

# Python executable path
PYTHON_PATH=python3

# Solver script path (relative to server)
SOLVER_PATH=../solver/solver.py
